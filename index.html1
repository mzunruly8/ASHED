<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>ASHED</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=IBM+Plex+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
:root{--red:#ff2d55;--blue:#00aaff;--green:#00ff99;--yellow:#ffd200;--bg:#060a12;--panel:rgba(8,14,28,0.9);--border:rgba(255,255,255,0.07);}
*{box-sizing:border-box;margin:0;padding:0;}
html,body{width:100%;height:100%;overflow:hidden;}
body{background:var(--bg);color:#e0e8ff;font-family:'IBM Plex Mono',monospace;height:100dvh;touch-action:none;position:relative;display:flex;align-items:center;justify-content:center;}
body::before{content:'';position:fixed;inset:0;background:radial-gradient(ellipse 60% 40% at 50% 0%,rgba(0,160,255,0.08) 0%,transparent 70%),radial-gradient(ellipse 50% 30% at 50% 100%,rgba(255,45,85,0.06) 0%,transparent 70%);pointer-events:none;z-index:0;}
body::after{content:'';position:fixed;inset:0;background:repeating-linear-gradient(0deg,transparent,transparent 2px,rgba(0,0,0,0.12) 2px,rgba(0,0,0,0.12) 4px);pointer-events:none;z-index:999;}
.screen{position:absolute;inset:0;display:none;flex-direction:column;align-items:center;justify-content:center;z-index:10;padding:14px;}
.screen.active{display:flex;}
#start-screen{gap:40px;text-align:center;}
.logo{position:relative;width:100%;display:flex;flex-direction:column;align-items:center;}
.logo h1{font-family:'Bebas Neue',sans-serif;font-size:min(22vw,110px);letter-spacing:0.15em;color:#fff;line-height:1;position:relative;text-shadow:0 0 40px rgba(0,170,255,0.5),0 0 80px rgba(0,170,255,0.2);width:100%;text-align:center;}
.logo h1::before,.logo h1::after{content:'ASHED';position:absolute;inset:0;font-family:'Bebas Neue',sans-serif;font-size:inherit;letter-spacing:inherit;text-align:center;}
.logo h1::before{color:var(--red);animation:glitch-r 3s infinite;clip-path:polygon(0 30%,100% 30%,100% 50%,0 50%);}
.logo h1::after{color:var(--blue);animation:glitch-b 3s infinite 0.1s;clip-path:polygon(0 60%,100% 60%,100% 75%,0 75%);}
@keyframes glitch-r{0%,90%,100%{transform:translateX(0);opacity:0}92%{transform:translateX(-4px);opacity:.8}94%{transform:translateX(3px);opacity:.6}96%{transform:translateX(0);opacity:0}}
@keyframes glitch-b{0%,88%,100%{transform:translateX(0);opacity:0}90%{transform:translateX(4px);opacity:.7}93%{transform:translateX(-2px);opacity:.5}95%{transform:translateX(0);opacity:0}}
.logo p{font-size:9px;letter-spacing:.5em;color:rgba(0,170,255,.5);margin-top:10px;text-transform:uppercase;}
.start-btns{display:flex;flex-direction:column;gap:10px;align-items:center;width:100%;max-width:300px;}
.btn-main{font-family:'Bebas Neue',sans-serif;font-size:20px;letter-spacing:.3em;color:#fff;background:transparent;border:1px solid rgba(0,170,255,.5);padding:14px 60px;cursor:pointer;position:relative;overflow:hidden;clip-path:polygon(12px 0%,100% 0%,calc(100% - 12px) 100%,0% 100%);transition:all .2s;width:100%;}
.btn-main::before{content:'';position:absolute;inset:0;background:linear-gradient(90deg,transparent,rgba(0,170,255,.15),transparent);transform:translateX(-100%);animation:shimmer 2s infinite;}
@keyframes shimmer{100%{transform:translateX(100%)}}
.btn-main:active{transform:scale(.95);background:rgba(0,170,255,.1);}
.btn-score{font-family:'Bebas Neue',sans-serif;font-size:16px;letter-spacing:.3em;color:rgba(255,210,0,.6);background:transparent;border:1px solid rgba(255,210,0,.25);padding:11px 40px;cursor:pointer;clip-path:polygon(10px 0%,100% 0%,calc(100% - 10px) 100%,0% 100%);transition:all .2s;width:100%;}
.btn-score:active{transform:scale(.95);color:var(--yellow);}
.btn-howto{background:none;border:none;color:rgba(255,255,255,.3);font-family:'IBM Plex Mono',monospace;font-size:9px;letter-spacing:.2em;text-transform:uppercase;cursor:pointer;padding:6px;margin-top:2px;}
.btn-howto:active{color:rgba(0,170,255,.7);}
#battle-screen{justify-content:space-between;padding:10px 12px;gap:8px;}
.panel{width:100%;max-width:440px;background:var(--panel);border:1px solid var(--border);padding:10px 12px;position:relative;overflow:hidden;}
.panel.enemy{border-left:3px solid var(--red);}
.panel.enemy::after{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(255,45,85,.04) 0%,transparent 60%);pointer-events:none;}
.panel.player{border-right:3px solid var(--blue);transition:border-color .3s;}
.panel.player::after{content:'';position:absolute;inset:0;background:linear-gradient(225deg,rgba(0,170,255,.04) 0%,transparent 60%);pointer-events:none;}
.panel.player.player-rage{border-right:3px solid var(--red);animation:player-rage-pulse 1s ease-in-out infinite;}
@keyframes player-rage-pulse{0%,100%{background:var(--panel)}50%{background:rgba(40,6,12,.9)}}
.panel-header{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:7px;}
.enemy-name{font-family:'Bebas Neue',sans-serif;font-size:18px;letter-spacing:.08em;color:var(--red);text-shadow:0 0 20px rgba(255,45,85,.4);}
.meta{font-size:9px;color:rgba(255,255,255,.3);letter-spacing:.2em;}
.hp-track{height:5px;background:rgba(255,255,255,.05);overflow:hidden;}
.hp-fill{height:100%;transition:width .4s cubic-bezier(.4,0,.2,1);position:relative;}
.hp-fill::after{content:'';position:absolute;right:0;top:0;bottom:0;width:3px;background:rgba(255,255,255,.5);filter:blur(1px);}
.hp-fill.e{background:linear-gradient(90deg,#900,var(--red));}
.hp-fill.p{background:linear-gradient(90deg,#005,var(--blue));transition:width .4s cubic-bezier(.4,0,.2,1),background .3s;}
.hp-fill.p.low{background:linear-gradient(90deg,#900,var(--red));animation:hp-low-pulse .9s ease-in-out infinite;}
@keyframes hp-low-pulse{0%,100%{filter:brightness(1)}50%{filter:brightness(1.4)}}
.hp-labels{display:flex;justify-content:space-between;margin-top:4px;font-size:9px;color:rgba(255,255,255,.3);letter-spacing:.1em;}
.burst{color:var(--red);font-weight:700;}
.rage-badge{display:none;font-size:8px;letter-spacing:.2em;color:var(--red);text-transform:uppercase;animation:rage-pulse 0.8s ease-in-out infinite;}
.rage-badge.active{display:inline;}
@keyframes rage-pulse{0%,100%{opacity:1}50%{opacity:.3}}
.grid-wrap{position:relative;width:100%;max-width:440px;aspect-ratio:1;background:rgba(4,8,20,.95);border:1px solid var(--border);flex-shrink:0;}
.grid-wrap::before{content:'';position:absolute;inset:0;background:linear-gradient(rgba(0,170,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(0,170,255,.025) 1px,transparent 1px);background-size:14.285% 14.285%;pointer-events:none;z-index:0;}
#grid-container{position:absolute;inset:3px;display:grid;grid-template-columns:repeat(7,1fr);grid-template-rows:repeat(7,1fr);gap:2px;}
.tile{background:rgba(10,18,36,.8);border:1px solid rgba(255,255,255,.04);display:flex;align-items:center;justify-content:center;cursor:pointer;user-select:none;border-radius:2px;transition:transform .1s,opacity .15s;}
.gem{width:58%;height:58%;border-radius:3px;position:relative;transition:all .15s cubic-bezier(.34,1.56,.64,1);display:flex;align-items:center;justify-content:center;font-family:'Bebas Neue',sans-serif;font-size:10px;letter-spacing:.05em;color:rgba(0,0,0,.65);pointer-events:none;}
.gem::before{content:'';position:absolute;top:1px;left:1px;right:1px;height:38%;background:rgba(255,255,255,.28);border-radius:2px 2px 50% 50%;pointer-events:none;}
.gem.red{background:var(--red);box-shadow:0 0 8px rgba(255,45,85,.5);}
.gem.blue{background:var(--blue);box-shadow:0 0 8px rgba(0,170,255,.5);}
.gem.green{background:var(--green);box-shadow:0 0 8px rgba(0,255,153,.5);}
.gem.yellow{background:var(--yellow);box-shadow:0 0 8px rgba(255,210,0,.5);}
.tile.selected{transform:scale(.85);border-color:rgba(255,255,255,.2);background:rgba(255,255,255,.04);}
.tile.selected .gem{width:78%;height:78%;}
.tile.selected .gem.red{box-shadow:0 0 18px rgba(255,45,85,.9),0 0 35px rgba(255,45,85,.3);}
.tile.selected .gem.blue{box-shadow:0 0 18px rgba(0,170,255,.9),0 0 35px rgba(0,170,255,.3);}
.tile.selected .gem.green{box-shadow:0 0 18px rgba(0,255,153,.9),0 0 35px rgba(0,255,153,.3);}
.tile.selected .gem.yellow{box-shadow:0 0 18px rgba(255,210,0,.9),0 0 35px rgba(255,210,0,.3);}
.tile.removing{animation:pop-squash .22s ease-out forwards;pointer-events:none;}
@keyframes pop-squash{0%{transform:scale(1);opacity:1}35%{transform:scale(1.15,.75);opacity:.9}60%{transform:scale(.7,1.2);opacity:.6}100%{transform:scale(0);opacity:0}}
@keyframes slideFromLeft{0%{transform:translateX(-50px);opacity:0}100%{transform:translateX(0);opacity:1}}
@keyframes slideFromRight{0%{transform:translateX(50px);opacity:0}100%{transform:translateX(0);opacity:1}}
.inject-left{animation:slideFromLeft .22s ease-out forwards;}
.inject-right{animation:slideFromRight .22s ease-out forwards;}
@keyframes gridShiftL{0%{transform:translateX(7px)}100%{transform:translateX(0)}}
@keyframes gridShiftR{0%{transform:translateX(-7px)}100%{transform:translateX(0)}}
.grid-shift-l{animation:gridShiftL .2s ease-out;}
.grid-shift-r{animation:gridShiftR .2s ease-out;}
#connectionCanvas{position:absolute;inset:0;pointer-events:none;z-index:5;width:100%;height:100%;}
.legend{display:flex;gap:10px;justify-content:center;width:100%;max-width:440px;}
.legend-item{display:flex;align-items:center;gap:4px;font-size:8px;letter-spacing:.15em;color:rgba(255,255,255,.3);text-transform:uppercase;}
.legend-dot{width:6px;height:6px;border-radius:1px;}
.status-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;}
.status-label{font-size:9px;letter-spacing:.25em;color:rgba(0,170,255,.6);text-transform:uppercase;}
.hp-text{font-size:9px;color:rgba(255,255,255,.3);}
.stat-row{display:flex;gap:6px;margin:8px 0;}
.stat-box{flex:1;background:rgba(0,0,0,.35);border:1px solid var(--border);padding:5px 4px;text-align:center;}
.stat-val{font-family:'Bebas Neue',sans-serif;font-size:18px;line-height:1;}
.stat-val.en{color:var(--yellow);text-shadow:0 0 12px rgba(255,210,0,.4);}
.stat-val.sh{color:var(--blue);text-shadow:0 0 12px rgba(0,170,255,.4);}
.stat-val.gd{color:#ffd700;text-shadow:0 0 12px rgba(255,215,0,.4);}
.stat-lbl{font-size:7px;letter-spacing:.15em;color:rgba(255,255,255,.2);margin-top:1px;}
.skills-row{display:grid;grid-template-columns:1fr 1fr;gap:6px;}
.skill-btn{background:rgba(0,0,0,.4);border:1px solid rgba(255,255,255,.07);color:rgba(255,255,255,.2);font-family:'IBM Plex Mono',monospace;font-size:8px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:8px 5px;cursor:pointer;transition:all .2s;}
.skill-btn .skill-name{display:block;font-family:'Bebas Neue',sans-serif;font-size:15px;letter-spacing:.05em;line-height:1;margin-bottom:2px;}
.skill-btn.ready-atk{border-color:rgba(255,45,85,.5);color:#fff;background:rgba(255,45,85,.1);box-shadow:0 0 16px rgba(255,45,85,.2);}
.skill-btn.ready-atk:active{transform:scale(.95);}
.skill-btn.ready-heal{border-color:rgba(0,255,153,.5);color:#fff;background:rgba(0,255,153,.08);box-shadow:0 0 16px rgba(0,255,153,.2);}
.skill-btn.ready-heal:active{transform:scale(.95);}
.notoriety-row{display:flex;align-items:center;gap:6px;margin-top:7px;}
.notoriety-track{flex:1;height:3px;background:rgba(255,255,255,.06);overflow:hidden;}
.notoriety-fill{height:100%;background:linear-gradient(90deg,#7c3aed,#a855f7,#ec4899);transition:width .4s ease;}
.notoriety-lbl{font-size:7px;letter-spacing:.2em;color:rgba(192,132,252,.5);text-transform:uppercase;white-space:nowrap;}
#score-bar{display:none;width:100%;max-width:440px;justify-content:space-between;align-items:center;padding:3px 2px;padding-right:98px;}
#score-bar.active{display:flex;}
.score-lbl{font-size:9px;letter-spacing:.3em;color:rgba(255,210,0,.5);}
.score-num{font-family:'Bebas Neue',sans-serif;font-size:22px;color:var(--yellow);}
.float-txt{position:fixed;pointer-events:none;font-family:'Bebas Neue',sans-serif;font-size:26px;letter-spacing:.05em;z-index:500;animation:floatUp .9s ease-out forwards;text-shadow:0 2px 10px rgba(0,0,0,.8);transform:translateX(-50%);}
@keyframes floatUp{0%{transform:translate(-50%,0) scale(1);opacity:1}20%{transform:translate(-50%,-12px) scale(1.1);opacity:1}100%{transform:translate(-50%,-65px) scale(.9);opacity:0}}
#flash{position:fixed;inset:0;pointer-events:none;z-index:200;opacity:0;transition:opacity .08s;}
#flash.on{opacity:.22;}
#particleCanvas{position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:300;}
@keyframes shake-sm{0%,100%{transform:translate(0)}20%{transform:translate(-2px,1px)}50%{transform:translate(2px,-1px)}80%{transform:translate(-1px,1px)}}
@keyframes shake-md{0%,100%{transform:translate(0)}15%{transform:translate(-4px,2px)}35%{transform:translate(4px,-2px)}55%{transform:translate(-4px,2px)}75%{transform:translate(3px,-1px)}}
@keyframes shake-lg{0%,100%{transform:translate(0)}10%{transform:translate(-5px,3px)}25%{transform:translate(5px,-3px)}40%{transform:translate(-6px,2px)}60%{transform:translate(6px,-2px)}80%{transform:translate(-3px,2px)}}
@keyframes shake-xl{0%,100%{transform:translate(0)}10%{transform:translate(-7px,4px)}25%{transform:translate(7px,-4px)}40%{transform:translate(-8px,3px)}55%{transform:translate(8px,-3px)}70%{transform:translate(-5px,3px)}85%{transform:translate(4px,-2px)}}
body.shake-sm{animation:shake-sm .32s cubic-bezier(.36,.07,.19,.97) both;}
body.shake-md{animation:shake-md .4s cubic-bezier(.36,.07,.19,.97) both;}
body.shake-lg{animation:shake-lg .48s cubic-bezier(.36,.07,.19,.97) both;}
body.shake-xl{animation:shake-xl .55s cubic-bezier(.36,.07,.19,.97) both;}
#end-screen{gap:28px;text-align:center;}
.end-title{font-family:'Bebas Neue',sans-serif;font-size:min(18vw,90px);letter-spacing:.1em;line-height:1;}
.end-title.win{color:var(--blue);text-shadow:0 0 50px rgba(0,170,255,.6);}
.end-title.lose{color:var(--red);text-shadow:0 0 50px rgba(255,45,85,.6);}
.end-stats{font-size:10px;letter-spacing:.2em;color:rgba(255,255,255,.3);line-height:2.2;text-align:left;border:1px solid var(--border);padding:14px 20px;background:var(--panel);}
.end-stats span{color:rgba(255,255,255,.7);float:right;font-family:'Bebas Neue',sans-serif;font-size:15px;letter-spacing:.1em;margin-left:24px;}
.btn-reboot{font-family:'Bebas Neue',sans-serif;font-size:18px;letter-spacing:.3em;color:#000;background:#fff;border:none;padding:13px 52px;cursor:pointer;clip-path:polygon(10px 0%,100% 0%,calc(100% - 10px) 100%,0% 100%);transition:all .15s;}
.btn-reboot:active{transform:scale(.95);}
#tutorial-overlay{position:fixed;inset:0;z-index:800;pointer-events:none;display:none;}
#tutorial-overlay.active{display:block;}
.tut-backdrop{position:absolute;inset:0;background:rgba(0,0,0,.75);pointer-events:all;}
.tut-box{position:absolute;background:rgba(5,9,18,.97);border:1px solid rgba(0,170,255,.35);padding:16px;max-width:270px;pointer-events:all;box-shadow:0 0 30px rgba(0,170,255,.15);}
.tut-box.arrow-up::before{content:'';position:absolute;top:-8px;left:50%;transform:translateX(-50%);border-left:8px solid transparent;border-right:8px solid transparent;border-bottom:8px solid rgba(0,170,255,.4);}
.tut-box.arrow-down::before{content:'';position:absolute;bottom:-8px;left:50%;transform:translateX(-50%);border-left:8px solid transparent;border-right:8px solid transparent;border-top:8px solid rgba(0,170,255,.4);}
.tut-step{font-size:8px;letter-spacing:.3em;color:rgba(0,170,255,.5);text-transform:uppercase;margin-bottom:5px;}
.tut-title{font-family:'Bebas Neue',sans-serif;font-size:18px;letter-spacing:.08em;color:#fff;margin-bottom:5px;}
.tut-body{font-size:10px;line-height:1.65;color:rgba(255,255,255,.5);margin-bottom:10px;}
.tut-gems{display:flex;flex-direction:column;gap:5px;margin-bottom:10px;}
.tut-gem{display:flex;align-items:center;gap:7px;font-size:9px;color:rgba(255,255,255,.5);letter-spacing:.08em;}
.tut-gem-dot{width:10px;height:10px;border-radius:2px;flex-shrink:0;}
.tut-next{font-family:'Bebas Neue',sans-serif;font-size:13px;letter-spacing:.2em;color:#000;background:var(--blue);border:none;padding:8px 20px;cursor:pointer;width:100%;transition:all .15s;}
.tut-next:active{transform:scale(.97);}
.tut-skip{font-size:8px;letter-spacing:.2em;color:rgba(255,255,255,.2);background:none;border:none;cursor:pointer;margin-top:6px;width:100%;text-transform:uppercase;padding:3px;}
.tut-skip:active{color:rgba(255,255,255,.5);}
.tut-ring{position:absolute;border:2px solid rgba(0,170,255,.7);border-radius:4px;box-shadow:0 0 20px rgba(0,170,255,.3),inset 0 0 10px rgba(0,170,255,.05);pointer-events:none;animation:pulse-ring 1.5s ease-in-out infinite;display:none;}
@keyframes pulse-ring{0%,100%{box-shadow:0 0 20px rgba(0,170,255,.3),inset 0 0 10px rgba(0,170,255,.05)}50%{box-shadow:0 0 35px rgba(0,170,255,.6),inset 0 0 15px rgba(0,170,255,.1)}}
.mute-btn{position:fixed;top:12px;right:12px;z-index:900;width:34px;height:34px;background:rgba(8,14,28,.85);border:1px solid rgba(0,170,255,.3);color:rgba(0,170,255,.7);font-size:14px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .15s;}
.mute-btn:active{transform:scale(.9);}
.mute-btn.muted{color:rgba(255,255,255,.25);border-color:rgba(255,255,255,.1);}
#track-overlay{position:fixed;inset:0;z-index:850;display:none;}
#track-overlay.active{display:block;}
.track-row{display:flex;align-items:center;justify-content:space-between;padding:10px 8px;border:1px solid rgba(255,255,255,.06);margin-bottom:6px;cursor:pointer;transition:all .15s;background:rgba(0,0,0,.2);}
.track-row:active{transform:scale(.98);}
.track-row.active{border-color:rgba(0,170,255,.4);background:rgba(0,170,255,.06);}
.track-name{font-family:'Bebas Neue',sans-serif;font-size:15px;letter-spacing:.08em;color:#fff;}
.track-desc{font-size:8px;letter-spacing:.1em;color:rgba(255,255,255,.35);text-transform:uppercase;margin-top:2px;}
.track-dot{width:9px;height:9px;border-radius:50%;border:1px solid rgba(255,255,255,.25);flex-shrink:0;}
.track-row.active .track-dot{background:var(--blue);border-color:var(--blue);box-shadow:0 0 8px rgba(0,170,255,.7);}

/* AVATAR EVOLUTION */
.status-left{display:flex;align-items:center;gap:8px;}
.avatar-wrap{position:relative;width:20px;height:20px;flex-shrink:0;}
.avatar-gem{width:100%;height:100%;border-radius:4px;transform:rotate(45deg);position:relative;transition:all .5s cubic-bezier(.34,1.56,.64,1);}
.avatar-gem::before{content:'';position:absolute;top:1px;left:1px;right:1px;height:35%;background:rgba(255,255,255,.35);border-radius:2px 2px 50% 50%;}
.avatar-gem.tier1{background:linear-gradient(135deg,#334155,#64748b);box-shadow:0 0 6px rgba(100,116,139,.4);}
.avatar-gem.tier2{background:linear-gradient(135deg,#0369a1,#00aaff);box-shadow:0 0 10px rgba(0,170,255,.5);}
.avatar-gem.tier3{background:linear-gradient(135deg,#059669,#00ff99);box-shadow:0 0 12px rgba(0,255,153,.5);}
.avatar-gem.tier4{background:linear-gradient(135deg,#7c3aed,#ec4899);box-shadow:0 0 14px rgba(236,72,153,.55);}
.avatar-gem.tier5{background:linear-gradient(135deg,#f59e0b,#fff8,#00aaff);box-shadow:0 0 20px rgba(255,255,255,.6);animation:avatar-ascend 2s ease-in-out infinite;}
@keyframes avatar-ascend{0%,100%{filter:brightness(1)}50%{filter:brightness(1.35)}}
.avatar-facets{position:absolute;inset:-4px;pointer-events:none;}
.facet-dot{position:absolute;width:5px;height:5px;border-radius:50%;box-shadow:0 0 4px currentColor;}

/* SHOP */
#shop-screen{gap:12px;padding:14px;}
.shop-header{width:100%;max-width:420px;display:flex;justify-content:space-between;align-items:baseline;margin-bottom:4px;}
.shop-title{font-family:'Bebas Neue',sans-serif;font-size:24px;letter-spacing:.1em;color:#fff;}
.shop-gold{font-size:10px;letter-spacing:.2em;color:rgba(255,210,0,.7);text-transform:uppercase;}
.shop-gold span{font-family:'Bebas Neue',sans-serif;font-size:16px;color:var(--yellow);margin-left:6px;}
.shop-list{width:100%;max-width:420px;display:flex;flex-direction:column;gap:8px;overflow-y:auto;max-height:60dvh;}
.shop-card{background:var(--panel);border:1px solid var(--border);padding:12px;display:flex;flex-direction:column;gap:6px;}
.shop-card-top{display:flex;justify-content:space-between;align-items:center;}
.shop-name{font-family:'Bebas Neue',sans-serif;font-size:16px;letter-spacing:.06em;color:#fff;}
.shop-desc{font-size:9px;color:rgba(255,255,255,.4);letter-spacing:.05em;}
.shop-levels{display:flex;gap:3px;margin:2px 0;}
.shop-pip{width:14px;height:4px;background:rgba(255,255,255,.08);}
.shop-pip.filled{background:currentColor;box-shadow:0 0 4px currentColor;}
.shop-buy{font-family:'IBM Plex Mono',monospace;font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:8px;border:1px solid rgba(0,170,255,.4);background:rgba(0,170,255,.08);color:#fff;cursor:pointer;transition:all .15s;}
.shop-buy:active{transform:scale(.96);}
.shop-buy.maxed{border-color:rgba(255,255,255,.15);background:rgba(255,255,255,.03);color:rgba(255,255,255,.3);cursor:default;}
.shop-buy.cant-afford{opacity:.45;}

/* PROFILE */
#profile-screen{gap:14px;padding:14px;}
.profile-header{display:flex;align-items:center;gap:12px;width:100%;max-width:420px;}
.profile-title{font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:.1em;color:#fff;}
.profile-grid{width:100%;max-width:420px;display:grid;grid-template-columns:1fr 1fr;gap:8px;}
.profile-card{background:var(--panel);border:1px solid var(--border);padding:10px;text-align:center;}
.profile-val{font-family:'Bebas Neue',sans-serif;font-size:22px;color:#fff;line-height:1;}
.profile-lbl{font-size:7px;letter-spacing:.15em;color:rgba(255,255,255,.35);text-transform:uppercase;margin-top:4px;}
.profile-card.wide{grid-column:1 / -1;}
.profile-upgrades{width:100%;max-width:420px;display:flex;flex-direction:column;gap:6px;}
.profile-upg-row{display:flex;justify-content:space-between;align-items:center;font-size:9px;letter-spacing:.1em;color:rgba(255,255,255,.5);padding:4px 2px;}
.profile-upg-pips{display:flex;gap:3px;}
</style>
</head>
<body>
<div id="flash"></div>
<canvas id="particleCanvas"></canvas>
<button class="mute-btn" id="mute-btn" onclick="toggleMute()">♪</button>
<button class="mute-btn" id="track-btn" style="right:54px;" onclick="openTrackPicker()">☰</button>

<div id="track-overlay">
  <div class="tut-backdrop" onclick="closeTrackPicker()"></div>
  <div class="tut-box" id="track-box" style="top:50%;left:50%;transform:translate(-50%,-50%);width:min(280px,calc(100vw - 20px));">
    <div class="tut-step">SOUNDTRACK</div>
    <div class="tut-title" style="margin-bottom:12px;">CHOOSE A BEAT</div>
    <div id="track-list"></div>
    <button class="tut-next" style="margin-top:12px;" onclick="closeTrackPicker()">DONE</button>
  </div>
</div>

<div id="tutorial-overlay">
  <div class="tut-backdrop"></div>
  <div class="tut-ring" id="tut-ring"></div>
  <div class="tut-box" id="tut-box">
    <div class="tut-step" id="tut-step">STEP 1 / 3</div>
    <div class="tut-title" id="tut-title">HOW TO PLAY</div>
    <div class="tut-body" id="tut-body"></div>
    <div class="tut-gems" id="tut-gems"></div>
    <button class="tut-next" id="tut-next" onclick="tutNext()">GOT IT →</button>
    <button class="tut-skip" onclick="dismissTutorial()">SKIP TUTORIAL</button>
  </div>
</div>

<div id="start-screen" class="screen active">
  <div class="logo">
    <h1>ASHED</h1>
    <p>UNRULY CORE ENGINE · V.6</p>
  </div>
  <div class="start-btns">
    <button class="btn-main" onclick="startGame('solo')">INITIATE</button>
    <button class="btn-score" onclick="startGame('score')">SCORE ATTACK</button>
    <button class="btn-score" onclick="openShop()">UPGRADE SHOP</button>
    <button class="btn-score" onclick="openProfile()">PROFILE</button>
    <button class="btn-howto" onclick="startGame('solo',true)">HOW TO PLAY</button>
  </div>
</div>

<div id="battle-screen" class="screen">
  <div id="score-bar">
    <span class="score-lbl">SCORE</span>
    <span class="score-num" id="score-val">0</span>
    <span class="score-lbl">TIME</span>
    <span class="score-num" id="timer-val">60</span>
  </div>
  <div class="panel enemy">
    <div class="panel-header">
      <span class="enemy-name" id="enemy-name">Void Weaver</span>
      <span class="meta">LVL <span id="enemy-level">1</span> &nbsp;<span class="rage-badge" id="rage-badge">⚡ RAGE</span></span>
    </div>
    <div class="hp-track"><div class="hp-fill e" id="enemy-hp-bar" style="width:100%"></div></div>
    <div class="hp-labels">
      <span id="enemy-hp-text">150 / 150</span>
      <span>BURST IN <span class="burst" id="enemy-timer">3</span></span>
    </div>
  </div>
  <div class="grid-wrap">
    <canvas id="connectionCanvas"></canvas>
    <div id="grid-container"></div>
  </div>
  <div class="legend">
    <div class="legend-item"><div class="legend-dot" style="background:var(--red)"></div>ATK</div>
    <div class="legend-item"><div class="legend-dot" style="background:var(--blue)"></div>SHIELD</div>
    <div class="legend-item"><div class="legend-dot" style="background:var(--green)"></div>HEAL</div>
    <div class="legend-item"><div class="legend-dot" style="background:var(--yellow)"></div>GOLD</div>
  </div>
  <div class="panel player" id="player-panel">
    <div class="status-row">
      <div class="status-left">
        <div class="avatar-wrap">
          <div class="avatar-gem tier1" id="avatar-gem"></div>
          <div class="avatar-facets" id="avatar-facets"></div>
        </div>
        <span class="status-label">SYSTEM — LV <span id="player-level">1</span></span>
      </div>
      <span class="hp-text" id="player-hp-text">80 / 80</span>
    </div>
    <div class="hp-track"><div class="hp-fill p" id="player-hp-bar" style="width:100%"></div></div>
    <div class="stat-row">
      <div class="stat-box"><div class="stat-val en" id="player-energy">0</div><div class="stat-lbl">ENERGY</div></div>
      <div class="stat-box"><div class="stat-val sh" id="player-def">0</div><div class="stat-lbl">SHIELD</div></div>
      <div class="stat-box"><div class="stat-val gd" id="player-gold">0</div><div class="stat-lbl">GOLD</div></div>
    </div>
    <div class="skills-row">
      <button class="skill-btn" id="skill-1" onclick="useSkill(0)"><span class="skill-name">SMITE</span>15 CORE · BIG DAMAGE</button>
      <button class="skill-btn" id="skill-2" onclick="useSkill(1)"><span class="skill-name">REBOOT</span>10 CORE · RESTORE HP</button>
    </div>
    <div class="notoriety-row">
      <span class="notoriety-lbl">NOTORIETY</span>
      <div class="notoriety-track"><div class="notoriety-fill" id="notoriety-fill" style="width:0%"></div></div>
      <span style="font-size:7px;letter-spacing:.15em;color:rgba(192,132,252,.5);min-width:22px;text-align:right;" id="notoriety-val">0</span>
    </div>
  </div>
</div>

<div id="end-screen" class="screen">
  <div class="end-title" id="end-title">VICTORY</div>
  <div class="end-stats" id="end-stats"></div>
  <button class="btn-reboot" onclick="goToStart()">REBOOT</button>
</div>

<div id="shop-screen" class="screen">
  <div class="shop-header">
    <div class="shop-title">UPGRADE SHOP</div>
    <div class="shop-gold">GOLD <span id="shop-gold-val">0</span></div>
  </div>
  <div class="shop-list" id="shop-list"></div>
  <button class="btn-reboot" onclick="closeShop()" style="margin-top:14px;">BACK</button>
</div>

<div id="profile-screen" class="screen">
  <div class="profile-header">
    <div class="avatar-wrap" style="width:44px;height:44px;">
      <div class="avatar-gem tier1" id="avatar-gem-profile"></div>
      <div class="avatar-facets" id="avatar-facets-profile"></div>
    </div>
    <div class="profile-title">OPERATIVE PROFILE</div>
  </div>
  <div class="profile-grid" id="profile-grid"></div>
  <div class="profile-upgrades" id="profile-upgrades"></div>
  <button class="btn-reboot" onclick="closeProfile()" style="margin-top:14px;">BACK</button>
</div>

<script>
// ── CONSTANTS ────────────────────────────────────────────────────────────────
const GRID=7;
const TYPES=['red','blue','green','yellow'];
const COLORS={red:'#ff2d55',blue:'#00aaff',green:'#00ff99',yellow:'#ffd200'};
const LABELS={red:'ATK',blue:'DEF',green:'HP',yellow:'EN'};
const ENEMY_NAMES=['Void Weaver','Null Specter','Hex Driver','Corrupt Node','Dark Cipher','Phantom Core','Shadow Pulse','Chaos Engine'];
const WIN_LEVEL=10;
const AUTO_CASCADE=['red','green'];
const NOTORIETY_KEY='ashed_notoriety_total';

// ── META STAT: NOTORIETY (persists across matches, post-match profile stat) ───
function getMetaNotoriety(){
  try{return parseInt(localStorage.getItem(NOTORIETY_KEY)||'0',10)||0;}catch(e){return 0;}
}
function addMetaNotoriety(n){
  try{
    const cur=getMetaNotoriety();
    localStorage.setItem(NOTORIETY_KEY,String(cur+n));
  }catch(e){/* storage unavailable, ignore */}
}

// ── META STAT: GOLD (persists across matches, spent in the Upgrade Shop) ──────
const GOLD_KEY='ashed_gold_total';
function getMetaGold(){
  try{return parseInt(localStorage.getItem(GOLD_KEY)||'0',10)||0;}catch(e){return 0;}
}
function addMetaGold(n){
  try{localStorage.setItem(GOLD_KEY,String(getMetaGold()+n));}catch(e){/* ignore */}
}
function spendMetaGold(n){
  try{
    const cur=getMetaGold();
    if(cur<n)return false;
    localStorage.setItem(GOLD_KEY,String(cur-n));
    return true;
  }catch(e){return false;}
}

// ── UPGRADE SHOP: permanent stat upgrades bought with meta Gold ───────────────
const UPGRADES_KEY='ashed_upgrades';
const UPGRADES_DEF={
  vitality:{name:'VITALITY CORE',desc:'+8 Max HP per level',base:40,max:5,color:'#00ff99'},
  amplifier:{name:'AMPLIFIER',desc:'+8% ATK damage per level',base:50,max:5,color:'#ff2d55'},
  insulator:{name:'INSULATOR',desc:'+8% Shield gain per level',base:45,max:5,color:'#00aaff'},
  overclock:{name:'OVERCLOCK',desc:'+8% Energy gain per level',base:55,max:5,color:'#ffd200'}
};
function getUpgradeLevels(){
  try{
    const raw=JSON.parse(localStorage.getItem(UPGRADES_KEY)||'{}');
    const out={};
    Object.keys(UPGRADES_DEF).forEach(k=>{out[k]=raw[k]||0;});
    return out;
  }catch(e){
    const out={};Object.keys(UPGRADES_DEF).forEach(k=>out[k]=0);return out;
  }
}
function saveUpgradeLevels(levels){
  try{localStorage.setItem(UPGRADES_KEY,JSON.stringify(levels));}catch(e){/* ignore */}
}
function upgMult(key){
  return 1+0.08*getUpgradeLevels()[key];
}
function upgradeCost(key,level){
  return UPGRADES_DEF[key].base*(level+1);
}
function buyUpgrade(key){
  const levels=getUpgradeLevels();
  const lvl=levels[key];
  if(lvl>=UPGRADES_DEF[key].max)return;
  const cost=upgradeCost(key,lvl);
  if(!spendMetaGold(cost))return;
  levels[key]=lvl+1;
  saveUpgradeLevels(levels);
  renderShop();
}

// ── LIFETIME STATS (feed the Profile screen) ───────────────────────────────────
const STATS_KEY='ashed_stats';
function getStats(){
  try{
    const raw=JSON.parse(localStorage.getItem(STATS_KEY)||'{}');
    return{
      matchesPlayed:raw.matchesPlayed||0,
      highestLevel:raw.highestLevel||1,
      totalDamage:raw.totalDamage||0,
      longestLink:raw.longestLink||0
    };
  }catch(e){
    return{matchesPlayed:0,highestLevel:1,totalDamage:0,longestLink:0};
  }
}
function bankMatchStats(matchDamage,matchLongestLink,levelReached){
  const s=getStats();
  s.matchesPlayed+=1;
  s.highestLevel=Math.max(s.highestLevel,levelReached);
  s.totalDamage+=matchDamage;
  s.longestLink=Math.max(s.longestLink,matchLongestLink);
  try{localStorage.setItem(STATS_KEY,JSON.stringify(s));}catch(e){/* ignore */}
}

// ── HIGH SCORE (Score Attack mode) ─────────────────────────────────────────────
const HIGHSCORE_KEY='ashed_highscore';
function getHighScore(){
  try{return parseInt(localStorage.getItem(HIGHSCORE_KEY)||'0',10)||0;}catch(e){return 0;}
}
function maybeUpdateHighScore(score){
  if(score>getHighScore()){
    try{localStorage.setItem(HIGHSCORE_KEY,String(score));}catch(e){/* ignore */}
    return true;
  }
  return false;
}

// ── TUTORIAL SEEN FLAG ──────────────────────────────────────────────────────────
const TUT_SEEN_KEY='ashed_tut_seen';
function hasSeenTutorial(){
  try{return localStorage.getItem(TUT_SEEN_KEY)==='1';}catch(e){return false;}
}
function markTutorialSeen(){
  try{localStorage.setItem(TUT_SEEN_KEY,'1');}catch(e){/* ignore */}
}

// ── STATE ────────────────────────────────────────────────────────────────────
let gameMode='solo';
let scoreTime=60,scoreTimer=null,gameScore=0;

function freshState(){
  const lv=getUpgradeLevels();
  const maxHp=80+lv.vitality*8;
  return{
    player:{hp:maxHp,maxHp:maxHp,level:1,energy:0,def:0,gold:0},
    enemy:{hp:150,maxHp:150,level:1,timer:3,maxTimer:3,atk:24,name:ENEMY_NAMES[0]},
    grid:[],
    isDragging:false,
    selectedTiles:[],
    isProcessing:false,
    notoriety:0, // this-match tally; banked into persistent meta total on match end
    matchDamage:0,
    longestLink:0
  };
}
let S=freshState();

const gridEl=document.getElementById('grid-container');
const canvas=document.getElementById('connectionCanvas');

// ── HAPTICS ──────────────────────────────────────────────────────────────────
function vibrate(pattern){
  try{
    if(navigator.vibrate)navigator.vibrate(pattern);
  }catch(e){/* unsupported, ignore */}
}

// ── AUDIO: PROCEDURAL COMBAT BEATS (3 selectable tracks) ───────────────────────
// Web Audio synthesis only — no sample files, keeps the build single-file.
// Each track is intentionally light: soft filtered tones, no heavy kick drum,
// just a readable pulse + a short melodic riff. Named Asphalt-playlist style.
const TRACKS=[
  {
    id:'core-pulse',
    name:'CORE PULSE',
    desc:'Steady & clean',
    bpm:100,
    pulseFreq:180,      // soft tick, not a deep kick
    waveform:'triangle',
    riff:[392,0,440,0,349.2,392,0,0],   // G4 . A4 . F4 G4 . .
    filterFreq:1400,
    gain:0.16
  },
  {
    id:'static-drift',
    name:'STATIC DRIFT',
    desc:'Sparse & ambient',
    bpm:82,
    pulseFreq:140,
    waveform:'sine',
    riff:[293.7,0,0,349.2,0,0,261.6,0], // D4 . . F4 . . C4 .
    filterFreq:900,
    gain:0.14
  },
  {
    id:'null-rush',
    name:'NULL RUSH',
    desc:'Driving & bright',
    bpm:116,
    pulseFreq:220,
    waveform:'square',
    riff:[440,494,0,440,523.3,0,494,0],  // A4 B4 . A4 C5 . B4 .
    filterFreq:1800,
    gain:0.12
  }
];
const TRACK_KEY='ashed_track_id';

function getSavedTrackId(){
  try{return localStorage.getItem(TRACK_KEY)||TRACKS[0].id;}catch(e){return TRACKS[0].id;}
}
function saveTrackId(id){
  try{localStorage.setItem(TRACK_KEY,id);}catch(e){/* ignore */}
}

const AudioEngine=(function(){
  let ctx=null,masterGain=null,muted=false,running=false,beatTimer=null,step=0;
  let rageActive=false;
  let trackIdx=Math.max(0,TRACKS.findIndex(t=>t.id===getSavedTrackId()));
  if(trackIdx<0)trackIdx=0;
  try{muted=localStorage.getItem('ashed_muted')==='1';}catch(e){muted=false;}

  function ensureCtx(){
    if(ctx)return ctx;
    try{
      ctx=new (window.AudioContext||window.webkitAudioContext)();
      masterGain=ctx.createGain();
      masterGain.gain.value=muted?0:1;
      masterGain.connect(ctx.destination);
    }catch(e){ctx=null;}
    return ctx;
  }

  function pulse(time,track){
    if(!ctx)return;
    const osc=ctx.createOscillator();
    const filt=ctx.createBiquadFilter();
    const g=ctx.createGain();
    osc.type='sine';
    osc.frequency.setValueAtTime(rageActive?track.pulseFreq*1.15:track.pulseFreq,time);
    filt.type='lowpass';
    filt.frequency.value=track.filterFreq;
    g.gain.setValueAtTime(track.gain,time);
    g.gain.exponentialRampToValueAtTime(0.001,time+0.1);
    osc.connect(filt);filt.connect(g);g.connect(masterGain);
    osc.start(time);osc.stop(time+0.12);
  }

  function blip(time,freq,track){
    if(!ctx)return;
    const osc=ctx.createOscillator();
    const filt=ctx.createBiquadFilter();
    const g=ctx.createGain();
    osc.type=track.waveform;
    osc.frequency.setValueAtTime(freq,time);
    filt.type='lowpass';
    filt.frequency.value=track.filterFreq;
    g.gain.setValueAtTime(0.0001,time);
    g.gain.linearRampToValueAtTime(track.gain*1.4,time+0.01);
    g.gain.exponentialRampToValueAtTime(0.001,time+0.16);
    osc.connect(filt);filt.connect(g);g.connect(masterGain);
    osc.start(time);osc.stop(time+0.18);
  }

  function scheduleStep(){
    if(!running||!ctx)return;
    const track=TRACKS[trackIdx];
    const t=ctx.currentTime+0.02;
    const beatDur=60/track.bpm/2; // 8th notes
    if(step%2===0)pulse(t,track);
    const note=track.riff[step%track.riff.length];
    if(note)blip(t,note*(rageActive?1.12:1),track);
    step++;
    beatTimer=setTimeout(scheduleStep,beatDur*1000*(rageActive?0.88:1));
  }

  function start(){
    const c=ensureCtx();
    if(!c)return;
    if(c.state==='suspended')c.resume().catch(()=>{});
    if(running)return;
    running=true;step=0;
    scheduleStep();
  }

  function stop(){
    running=false;
    if(beatTimer)clearTimeout(beatTimer);
    beatTimer=null;
  }

  function setRage(on){rageActive=!!on;}

  function toggleMute(){
    muted=!muted;
    if(masterGain)masterGain.gain.value=muted?0:1;
    try{localStorage.setItem('ashed_muted',muted?'1':'0');}catch(e){/* ignore */}
    return muted;
  }

  function isMuted(){return muted;}

  function setTrack(id){
    const idx=TRACKS.findIndex(t=>t.id===id);
    if(idx<0)return;
    trackIdx=idx;
    step=0;
    saveTrackId(id);
  }

  function getTrackId(){return TRACKS[trackIdx].id;}

  return{start,stop,setRage,toggleMute,isMuted,setTrack,getTrackId};
})();

function toggleMute(){
  const nowMuted=AudioEngine.toggleMute();
  const btn=document.getElementById('mute-btn');
  btn.textContent=nowMuted?'✕':'♪';
  btn.classList.toggle('muted',nowMuted);
}

// ── TRACK PICKER ────────────────────────────────────────────────────────────
function openTrackPicker(){
  renderTrackList();
  document.getElementById('track-overlay').classList.add('active');
}
function closeTrackPicker(){
  document.getElementById('track-overlay').classList.remove('active');
}
function renderTrackList(){
  const list=document.getElementById('track-list');
  list.innerHTML='';
  const current=AudioEngine.getTrackId();
  TRACKS.forEach(t=>{
    const row=document.createElement('div');
    row.className='track-row'+(t.id===current?' active':'');
    row.innerHTML=`<div class="track-info"><div class="track-name">${t.name}</div><div class="track-desc">${t.desc}</div></div><div class="track-dot"></div>`;
    row.onclick=()=>{AudioEngine.setTrack(t.id);renderTrackList();};
    list.appendChild(row);
  });
}

// ── HIT-STOP ─────────────────────────────────────────────────────────────────
// Brief freeze on heavy hits, scaled to impact magnitude, inserted into the
// sequence right after impact FX fire and before tiles clear.
function hitStopDuration(linkLen){
  if(linkLen>=6)return 140;
  if(linkLen>=5)return 90;
  if(linkLen>=4)return 50;
  return 0;
}

// ── PARTICLES ────────────────────────────────────────────────────────────────
const pCanvas=document.getElementById('particleCanvas');
const pCtx=pCanvas.getContext('2d');
let particles=[];
function resizePCanvas(){pCanvas.width=window.innerWidth;pCanvas.height=window.innerHeight;}
resizePCanvas();
window.addEventListener('resize',resizePCanvas);

function spawnImpact(x,y,color,count){
  for(let i=0;i<count;i++){
    const a=Math.random()*Math.PI*2,spd=2+Math.random()*7;
    particles.push({x,y,vx:Math.cos(a)*spd,vy:Math.sin(a)*spd,color,life:1,decay:0.022+Math.random()*0.04,size:3+Math.random()*5});
  }
}
(function animP(){
  pCtx.clearRect(0,0,pCanvas.width,pCanvas.height);
  particles=particles.filter(p=>p.life>0);
  for(const p of particles){
    p.x+=p.vx;p.y+=p.vy;p.vy+=0.15;p.vx*=0.96;p.life-=p.decay;
    pCtx.save();
    pCtx.globalAlpha=Math.max(0,p.life);
    pCtx.shadowBlur=12;pCtx.shadowColor=p.color;
    pCtx.fillStyle=p.color;
    pCtx.beginPath();
    pCtx.arc(p.x,p.y,Math.max(0.01,p.size*p.life),0,Math.PI*2);
    pCtx.fill();
    pCtx.restore();
  }
  requestAnimationFrame(animP);
})();

function fireImpact(tiles,color,linkLen){
  const count=Math.min(4+linkLen*4,44);
  for(const t of tiles){
    const cell=S.grid[t.r]?.[t.c];
    if(!cell?.el)continue;
    const r=cell.el.getBoundingClientRect();
    spawnImpact(r.left+r.width/2,r.top+r.height/2,color,Math.ceil(count/tiles.length));
  }
}

// ── SHAKE ────────────────────────────────────────────────────────────────────
function triggerShake(linkLen){
  const cls=linkLen<=3?'shake-sm':linkLen<=4?'shake-md':linkLen<=5?'shake-lg':'shake-xl';
  ['shake-sm','shake-md','shake-lg','shake-xl'].forEach(c=>document.body.classList.remove(c));
  void document.body.offsetWidth;
  document.body.classList.add(cls);
  setTimeout(()=>document.body.classList.remove(cls),600);
}

// ── SCREENS ──────────────────────────────────────────────────────────────────
function showScreen(id){
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
}

// ── START ────────────────────────────────────────────────────────────────────
function startGame(mode,forceTutorial){
  gameMode=mode||'solo';
  S=freshState();
  gameScore=0;scoreTime=60;
  if(scoreTimer)clearInterval(scoreTimer);
  const sb=document.getElementById('score-bar');
  if(mode==='score'){
    sb.classList.add('active');
    document.getElementById('score-val').textContent='0';
    document.getElementById('timer-val').textContent='60';
    scoreTimer=setInterval(()=>{
      scoreTime--;
      document.getElementById('timer-val').textContent=scoreTime;
      if(scoreTime<=0){clearInterval(scoreTimer);showEnd(true,true);}
    },1000);
  } else {
    sb.classList.remove('active');
  }
  showScreen('battle-screen');
  buildGrid();
  updateUI();
  resizeCanvas();
  if(forceTutorial||!hasSeenTutorial())showTutorial();
  AudioEngine.start();
}

function goToStart(){
  if(scoreTimer)clearInterval(scoreTimer);
  S=freshState();
  gameScore=0;scoreTime=60;
  showScreen('start-screen');
  AudioEngine.stop();
}

// ── TUTORIAL ────────────────────────────────────────────────────────────────
const TUT_STEPS=[
  {title:'CONNECT THE GEMS',body:'Drag across 3 or more gems of the SAME colour. They must be touching — including diagonally. Release to activate.',gems:null,target:'grid'},
  {title:'COLOUR = ACTION',body:'Every colour triggers a different effect when matched:',gems:[
    {color:'#ff2d55',label:'RED — Deals damage to the enemy'},
    {color:'#00aaff',label:'BLUE — Raises your shield'},
    {color:'#00ff99',label:'GREEN — Recovers your health'},
    {color:'#ffd200',label:'YELLOW — Earns gold + core energy'}
  ],target:'legend'},
  {title:'WATCH THE BURST',body:'The enemy attacks every few turns. Shield absorbs hits. Charge energy to unlock SMITE and REBOOT. Reach Level 10 to win.',gems:null,target:'enemy'}
];
let tutStep=0;
function showTutorial(){tutStep=0;renderTutStep();document.getElementById('tutorial-overlay').classList.add('active');}
function renderTutStep(){
  const s=TUT_STEPS[tutStep];
  document.getElementById('tut-step').textContent=`STEP ${tutStep+1} / ${TUT_STEPS.length}`;
  document.getElementById('tut-title').textContent=s.title;
  document.getElementById('tut-body').textContent=s.body;
  document.getElementById('tut-next').textContent=tutStep<TUT_STEPS.length-1?'GOT IT →':'START BATTLE';
  const gemsEl=document.getElementById('tut-gems');gemsEl.innerHTML='';
  if(s.gems){s.gems.forEach(g=>{const row=document.createElement('div');row.className='tut-gem';row.innerHTML=`<div class="tut-gem-dot" style="background:${g.color}"></div>${g.label}`;gemsEl.appendChild(row);});}
  positionTut(s.target);
}
function positionTut(target){
  const box=document.getElementById('tut-box'),ring=document.getElementById('tut-ring');
  const vw=window.innerWidth,vh=window.innerHeight;
  let refEl=null;
  if(target==='grid')refEl=document.querySelector('.grid-wrap');
  if(target==='legend')refEl=document.querySelector('.legend');
  if(target==='enemy')refEl=document.querySelector('.panel.enemy');
  box.className='tut-box';box.style.transform='';
  if(refEl){
    const r=refEl.getBoundingClientRect();
    ring.style.display='block';ring.style.left=(r.left-4)+'px';ring.style.top=(r.top-4)+'px';ring.style.width=(r.width+8)+'px';ring.style.height=(r.height+8)+'px';
    const boxW=Math.min(270,vw-20),spaceBelow=vh-r.bottom;
    if(spaceBelow>240){box.style.top=(r.bottom+14)+'px';box.classList.add('arrow-up');}
    else{box.style.top=Math.max(10,r.top-14)+'px';box.style.transform='translateY(-100%)';box.classList.add('arrow-down');}
    let left=r.left+r.width/2-boxW/2;left=Math.max(10,Math.min(left,vw-boxW-10));
    box.style.left=left+'px';box.style.width=boxW+'px';
  } else {
    ring.style.display='none';box.style.top='50%';box.style.left='50%';box.style.transform='translate(-50%,-50%)';box.style.width=Math.min(270,vw-20)+'px';
  }
}
function tutNext(){tutStep++;if(tutStep>=TUT_STEPS.length)dismissTutorial();else renderTutStep();}
function dismissTutorial(){document.getElementById('tutorial-overlay').classList.remove('active');document.getElementById('tut-ring').style.display='none';markTutorialSeen();}

// ── GRID ─────────────────────────────────────────────────────────────────────
function buildGrid(){
  gridEl.innerHTML='';
  S.grid=[];
  for(let r=0;r<GRID;r++){S.grid[r]=[];for(let c=0;c<GRID;c++)makeTile(r,c);}
}

function makeTile(r,c,type,injectDir){
  type=type||TYPES[Math.floor(Math.random()*TYPES.length)];
  const tile=document.createElement('div');
  tile.className='tile';
  if(injectDir)tile.classList.add('inject-'+injectDir);
  tile.dataset.row=r;
  tile.dataset.col=c;
  tile.dataset.type=type;
  const gem=document.createElement('div');
  gem.className='gem '+type;
  gem.textContent=LABELS[type];
  tile.appendChild(gem);
  // Use closure-captured r,c for reliable listener binding
  tile.addEventListener('mousedown',function(){startDrag(r,c);});
  tile.addEventListener('touchstart',function(e){e.preventDefault();startDrag(r,c);},{passive:false});
  gridEl.appendChild(tile);
  S.grid[r][c]={type,el:tile};
}

// ── DRAG ─────────────────────────────────────────────────────────────────────
window.addEventListener('mousemove',function(e){
  if(!S.isDragging||S.isProcessing)return;
  const tile=e.target.closest('.tile');
  if(tile)continueDrag(+tile.dataset.row,+tile.dataset.col);
});

window.addEventListener('touchmove',function(e){
  if(!S.isDragging||S.isProcessing)return;
  const t=e.touches[0];
  const el=document.elementFromPoint(t.clientX,t.clientY);
  const tile=el?el.closest('.tile'):null;
  if(tile)continueDrag(+tile.dataset.row,+tile.dataset.col);
},{passive:false});

window.addEventListener('mouseup',endDrag);
window.addEventListener('touchend',endDrag);

function startDrag(r,c){
  if(S.isProcessing)return;
  if(!S.grid[r]||!S.grid[r][c])return;
  S.isDragging=true;
  S.selectedTiles=[{r,c}];
  S.grid[r][c].el.classList.add('selected');
  drawLines();
}

function continueDrag(r,c){
  if(!S.isDragging||S.isProcessing)return;
  if(!S.grid[r]||!S.grid[r][c])return;
  const sel=S.selectedTiles;
  if(!sel.length)return;
  const last=sel[sel.length-1];
  if(!S.grid[last.r]||!S.grid[last.r][last.c])return;

  if(sel.length>1){
    const prev=sel[sel.length-2];
    if(prev.r===r&&prev.c===c){
      S.grid[last.r][last.c].el.classList.remove('selected');
      sel.pop();
      drawLines();
      return;
    }
  }

  if(last.r===r&&last.c===c)return;
  const isAdj=Math.abs(last.r-r)<=1&&Math.abs(last.c-c)<=1;
  const isSame=S.grid[r][c].type===S.grid[last.r][last.c].type;
  const isNew=!sel.some(function(t){return t.r===r&&t.c===c;});
  if(isAdj&&isSame&&isNew){
    sel.push({r,c});
    S.grid[r][c].el.classList.add('selected');
    drawLines();
  }
}

async function endDrag(){
  if(!S.isDragging)return;
  S.isDragging=false;
  if(S.selectedTiles.length>=3){
    await processMatch(S.selectedTiles.slice(),true);
  } else {
    S.selectedTiles.forEach(function(t){if(S.grid[t.r]&&S.grid[t.r][t.c])S.grid[t.r][t.c].el.classList.remove('selected');});
    S.selectedTiles=[];
    clearLines();
  }
}

// ── PROCESS MATCH ────────────────────────────────────────────────────────────
async function processMatch(tiles,isPlayerTurn){
  S.isProcessing=true;
  S.selectedTiles=[];
  clearLines();

  try{
    const linkLen=tiles.length;
    S.longestLink=Math.max(S.longestLink,linkLen);
    const firstCell=S.grid[tiles[0].r]&&S.grid[tiles[0].r][tiles[0].c];
    if(!firstCell)throw new Error('null cell');
    const type=firstCell.type;
    const color=COLORS[type];

    const avgCol=tiles.reduce(function(s,t){return s+t.c;},0)/tiles.length;
    const injectSide=avgCol<GRID/2?'left':'right';

    switch(type){
      case 'red': dealDamage(Math.round(linkLen*7*upgMult('amplifier')),linkLen); break;
      case 'blue':{const sh=Math.round(linkLen*4*upgMult('insulator'));S.player.def+=sh;showFloat('SHIELD +'+sh,COLORS.blue);break;}
      case 'green':{const hp=linkLen*5;S.player.hp=Math.min(S.player.maxHp,S.player.hp+hp);showFloat('HEAL +'+hp,COLORS.green);break;}
      case 'yellow':{
        const gold=linkLen*3,en=Math.round(linkLen*3*upgMult('overclock'));
        S.player.gold+=gold;S.player.energy+=en;
        showFloat('GOLD +'+gold,COLORS.yellow);
        if(gameMode==='score')gameScore+=gold*10;
        break;
      }
    }

    const nGain=linkLen>=6?15:linkLen>=5?10:linkLen>=4?5:2;
    S.notoriety=Math.min(100,S.notoriety+nGain);
    if(gameMode==='score'&&type!=='yellow')gameScore+=linkLen*50;

    fireImpact(tiles,color,linkLen);
    triggerShake(linkLen);

    // Hit-stop: brief freeze on heavy hits before tiles clear
    const hs=hitStopDuration(linkLen);
    if(hs>0)await delay(hs);

    tiles.forEach(function(t){
      if(S.grid[t.r]&&S.grid[t.r][t.c])S.grid[t.r][t.c].el.classList.add('removing');
    });

    await delay(220);

    await sideInject(tiles,injectSide);

    if(isPlayerTurn){
      S.enemy.timer--;
      if(S.enemy.timer<=0){
        await delay(100);
        await enemyAttack();
        S.enemy.timer=S.enemy.maxTimer;
      }
    }

    await checkCascade();

    updateUI();
    if(S.player.hp<=0){showEnd(false);return;}
    if(S.enemy.hp<=0)handleVictory();

  } catch(err){
    console.warn('processMatch error:',err);
  } finally {
    S.isProcessing=false;
  }
}

// ── SIDE INJECTION ───────────────────────────────────────────────────────────
async function sideInject(clearedTiles,side){
  const clearedSet=new Set(clearedTiles.map(function(t){return t.r+','+t.c;}));

  const snapshot=[];
  for(let r=0;r<GRID;r++){
    const survivors=[];
    for(let c=0;c<GRID;c++){
      const cell=S.grid[r]&&S.grid[r][c];
      if(cell&&!clearedSet.has(r+','+c))survivors.push(cell.type);
    }
    const gaps=GRID-survivors.length;
    const row=side==='left'
      ?Array(gaps).fill(null).concat(survivors)
      :survivors.concat(Array(gaps).fill(null));
    snapshot.push(row);
  }

  gridEl.innerHTML='';
  for(let r=0;r<GRID;r++){S.grid[r]=[];for(let c=0;c<GRID;c++)S.grid[r][c]=null;}

  const gw=document.querySelector('.grid-wrap');
  gw.classList.remove('grid-shift-l','grid-shift-r');
  void gw.offsetWidth;
  gw.classList.add(side==='left'?'grid-shift-l':'grid-shift-r');
  setTimeout(function(){gw.classList.remove('grid-shift-l','grid-shift-r');},220);

  for(let r=0;r<GRID;r++){
    for(let c=0;c<GRID;c++){
      const saved=snapshot[r][c];
      const isNew=saved===null;
      const type=isNew?TYPES[Math.floor(Math.random()*TYPES.length)]:saved;
      makeTile(r,c,type,isNew?side:null);
    }
  }

  await delay(260);
}

// ── AUTO CASCADE ─────────────────────────────────────────────────────────────
async function checkCascade(){
  for(let ti=0;ti<AUTO_CASCADE.length;ti++){
    const type=AUTO_CASCADE[ti];
    const visited=[];
    for(let r=0;r<GRID;r++){visited.push([]);for(let c=0;c<GRID;c++)visited[r].push(false);}

    for(let r=0;r<GRID;r++){
      for(let c=0;c<GRID;c++){
        if(visited[r][c])continue;
        if(!S.grid[r]||!S.grid[r][c]||S.grid[r][c].type!==type)continue;

        const cluster=[],queue=[{r,c}];
        visited[r][c]=true;
        while(queue.length){
          const cur=queue.shift();
          cluster.push(cur);
          const nbrs=adjOf(cur.r,cur.c);
          for(let n=0;n<nbrs.length;n++){
            const nb=nbrs[n];
            if(!visited[nb.r][nb.c]&&S.grid[nb.r]&&S.grid[nb.r][nb.c]&&S.grid[nb.r][nb.c].type===type){
              visited[nb.r][nb.c]=true;
              queue.push(nb);
            }
          }
        }

        if(cluster.length>=3){
          cluster.forEach(function(t){if(S.grid[t.r]&&S.grid[t.r][t.c])S.grid[t.r][t.c].el.classList.add('selected');});
          await delay(280);
          showFloat('CASCADE!',COLORS[type]);
          await processMatch(cluster,false);
          await checkCascade();
          return;
        }
      }
    }
  }
}

function adjOf(r,c){
  const out=[];
  for(let dr=-1;dr<=1;dr++){
    for(let dc=-1;dc<=1;dc++){
      if(!dr&&!dc)continue;
      const nr=r+dr,nc=c+dc;
      if(nr>=0&&nr<GRID&&nc>=0&&nc<GRID)out.push({r:nr,c:nc});
    }
  }
  return out;
}

// ── COMBAT ───────────────────────────────────────────────────────────────────
function dealDamage(amount,linkLen){
  S.enemy.hp=Math.max(0,S.enemy.hp-amount);
  S.matchDamage+=amount;
  showFloat('-'+amount,COLORS.red,true);
  doFlash(COLORS.red);
  if(linkLen>=6)vibrate([30,20,30]);
  else if(linkLen>=4)vibrate(25);
  else vibrate(12);
}

async function enemyAttack(){
  const isRage=S.enemy.hp/S.enemy.maxHp<0.3;
  const variance=Math.floor(Math.random()*9)-4;
  let atk=S.enemy.atk+variance;
  if(isRage)atk=Math.floor(atk*1.5);
  const hit=Math.max(1,atk-S.player.def);
  S.player.def=0;
  S.player.hp=Math.max(0,S.player.hp-hit);
  showFloat(isRage?'⚡ RAGE -'+hit:'HIT -'+hit,'#ffffff');
  doFlash(isRage?'#ff2d55':'#ffffff');
  triggerShake(isRage?4:3);
  vibrate(isRage?[40,30,40,30,40]:35);
  const hpPct=S.player.hp/S.player.maxHp;
  updateUI();
  if(hpPct<0.3)await delay(80); // extra hit-stop beat when dropping into low-HP state
  await delay(320);
}

function doFlash(color){
  const f=document.getElementById('flash');
  f.style.background=color;f.classList.add('on');
  setTimeout(function(){f.classList.remove('on');},100);
}

// ── LEVEL / WIN ──────────────────────────────────────────────────────────────
function handleVictory(){
  if(S.player.level>=WIN_LEVEL){showEnd(true);return;}
  S.player.level++;
  S.player.maxHp+=30;
  S.player.hp=S.player.maxHp;
  S.enemy.level++;
  S.enemy.maxHp+=80;
  S.enemy.hp=S.enemy.maxHp;
  S.enemy.atk+=12;
  S.enemy.name=ENEMY_NAMES[Math.min(S.enemy.level-1,ENEMY_NAMES.length-1)];
  if(S.enemy.level%2===0)S.enemy.maxTimer=Math.max(1,S.enemy.maxTimer-1);
  S.enemy.timer=S.enemy.maxTimer;
  showFloat('LEVEL UP',COLORS.blue);
  updateUI();
}

// ── SKILLS ───────────────────────────────────────────────────────────────────
function useSkill(idx){
  if(S.isProcessing)return;
  if(idx===0&&S.player.energy>=15){
    S.player.energy-=15;
    dealDamage(Math.round((60+S.player.level*15)*upgMult('amplifier')),6);
    triggerShake(4);
    updateUI();
    if(S.enemy.hp<=0)handleVictory();
  } else if(idx===1&&S.player.energy>=10){
    S.player.energy-=10;
    const h=50+S.player.level*10;
    S.player.hp=Math.min(S.player.maxHp,S.player.hp+h);
    showFloat('REBOOT +'+h,COLORS.green);
    vibrate(15);
    updateUI();
  }
}

// ── UI ───────────────────────────────────────────────────────────────────────
function updateUI(){
  const eHp=Math.max(0,S.enemy.hp),pHp=Math.max(0,S.player.hp);
  document.getElementById('enemy-hp-bar').style.width=(eHp/S.enemy.maxHp*100)+'%';
  document.getElementById('enemy-hp-text').textContent=Math.ceil(eHp)+' / '+S.enemy.maxHp;
  document.getElementById('enemy-timer').textContent=S.enemy.timer;
  document.getElementById('enemy-level').textContent=S.enemy.level;
  document.getElementById('enemy-name').textContent=S.enemy.name;
  const enemyRage=S.enemy.hp/S.enemy.maxHp<0.3;
  document.getElementById('rage-badge').classList.toggle('active',enemyRage);
  AudioEngine.setRage(enemyRage);

  const pHpPct=pHp/S.player.maxHp;
  const playerLow=pHpPct<0.3;
  document.getElementById('player-hp-bar').style.width=(pHpPct*100)+'%';
  document.getElementById('player-hp-bar').classList.toggle('low',playerLow);
  document.getElementById('player-panel').classList.toggle('player-rage',playerLow);
  document.getElementById('player-hp-text').textContent=Math.ceil(pHp)+' / '+S.player.maxHp;
  document.getElementById('player-energy').textContent=S.player.energy;
  document.getElementById('player-def').textContent=S.player.def;
  document.getElementById('player-gold').textContent=S.player.gold;
  document.getElementById('player-level').textContent=S.player.level;
  updateAvatar();
  document.getElementById('notoriety-fill').style.width=S.notoriety+'%';
  document.getElementById('notoriety-val').textContent=S.notoriety;
  if(gameMode==='score')document.getElementById('score-val').textContent=gameScore;
  document.getElementById('skill-1').className=S.player.energy>=15?'skill-btn ready-atk':'skill-btn';
  document.getElementById('skill-2').className=S.player.energy>=10?'skill-btn ready-heal':'skill-btn';
}

// ── CANVAS ───────────────────────────────────────────────────────────────────
function resizeCanvas(){
  const wrap=document.querySelector('.grid-wrap');
  if(!wrap)return;
  const r=wrap.getBoundingClientRect();
  canvas.width=r.width;canvas.height=r.height;
  drawLines();
}
function clearLines(){
  canvas.getContext('2d').clearRect(0,0,canvas.width,canvas.height);
}
function drawLines(){
  const ctx=canvas.getContext('2d');
  ctx.clearRect(0,0,canvas.width,canvas.height);
  if(!S.selectedTiles||S.selectedTiles.length<2)return;
  const first=S.grid[S.selectedTiles[0].r]&&S.grid[S.selectedTiles[0].r][S.selectedTiles[0].c];
  if(!first)return;
  const color=COLORS[first.type];
  const wrap=document.querySelector('.grid-wrap');
  const wr=wrap.getBoundingClientRect();
  ctx.beginPath();ctx.lineWidth=3;ctx.lineCap='round';ctx.lineJoin='round';
  ctx.strokeStyle=color;ctx.shadowBlur=14;ctx.shadowColor=color;
  for(let i=0;i<S.selectedTiles.length;i++){
    const p=S.selectedTiles[i];
    const cell=S.grid[p.r]&&S.grid[p.r][p.c];
    if(!cell||!cell.el)continue;
    const r=cell.el.getBoundingClientRect();
    const x=r.left-wr.left+r.width/2,y=r.top-wr.top+r.height/2;
    i===0?ctx.moveTo(x,y):ctx.lineTo(x,y);
  }
  ctx.stroke();
}

// ── FLOAT TEXT ───────────────────────────────────────────────────────────────
function showFloat(text,color,isEnemy){
  const d=document.createElement('div');
  d.className='float-txt';d.textContent=text;d.style.color=color;
  d.style.left=(35+Math.random()*30)+'%';
  d.style.top=isEnemy?'16%':'70%';
  document.body.appendChild(d);
  setTimeout(function(){d.remove();},900);
}

// ── END SCREEN ───────────────────────────────────────────────────────────────
function showEnd(win,timeUp){
  if(scoreTimer)clearInterval(scoreTimer);
  AudioEngine.stop();
  showScreen('end-screen');
  const t=document.getElementById('end-title');
  if(timeUp){t.textContent='TIME UP';t.className='end-title win';}
  else if(win){t.textContent='VICTORY';t.className='end-title win';}
  else{t.textContent='CRITICAL FAILURE';t.className='end-title lose';}

  // Bank this match's notoriety, gold, and lifetime stats into persistent totals
  addMetaNotoriety(S.notoriety);
  addMetaGold(S.player.gold);
  bankMatchStats(S.matchDamage,S.longestLink,S.player.level);
  let newHighScore=false;
  if(gameMode==='score')newHighScore=maybeUpdateHighScore(gameScore);
  const metaTotal=getMetaNotoriety();

  document.getElementById('end-stats').innerHTML=
    'LEVEL REACHED <span>'+S.player.level+'</span><br>'+
    'MATCH NOTORIETY <span>'+S.notoriety+'</span><br>'+
    'TOTAL NOTORIETY <span>'+metaTotal+'</span><br>'+
    'GOLD EARNED <span>'+S.player.gold+'</span><br>'+
    (gameMode==='score'?'FINAL SCORE <span>'+gameScore+'</span><br>'+
      (newHighScore?'<span style="color:#ffd200;">NEW HIGH SCORE!</span><br>':'BEST <span>'+getHighScore()+'</span><br>'):'');
}

// ── PROFILE SCREEN ────────────────────────────────────────────────────────────
function openProfile(){
  renderProfile();
  showScreen('profile-screen');
}
function closeProfile(){
  showScreen('start-screen');
}
function renderProfile(){
  const stats=getStats();
  const notoriety=getMetaNotoriety();
  const gold=getMetaGold();
  const highScore=getHighScore();
  const levels=getUpgradeLevels();

  const grid=document.getElementById('profile-grid');
  grid.innerHTML=`
    <div class="profile-card"><div class="profile-val">${stats.matchesPlayed}</div><div class="profile-lbl">Matches Played</div></div>
    <div class="profile-card"><div class="profile-val">${stats.highestLevel}</div><div class="profile-lbl">Highest Level</div></div>
    <div class="profile-card"><div class="profile-val">${highScore}</div><div class="profile-lbl">Best Score</div></div>
    <div class="profile-card"><div class="profile-val">${stats.longestLink}</div><div class="profile-lbl">Longest Link</div></div>
    <div class="profile-card"><div class="profile-val">${notoriety}</div><div class="profile-lbl">Notoriety</div></div>
    <div class="profile-card"><div class="profile-val">${gold}</div><div class="profile-lbl">Gold</div></div>
    <div class="profile-card wide"><div class="profile-val">${stats.totalDamage.toLocaleString()}</div><div class="profile-lbl">Total Damage Dealt</div></div>
  `;

  // Avatar preview reflects lifetime highest level + owned upgrades
  const tier=stats.highestLevel>=9?5:stats.highestLevel>=7?4:stats.highestLevel>=5?3:stats.highestLevel>=3?2:1;
  const gem=document.getElementById('avatar-gem-profile');
  gem.className='avatar-gem tier'+tier;
  const facetsEl=document.getElementById('avatar-facets-profile');
  facetsEl.innerHTML='';
  const positions=[{top:'-4px',left:'-4px'},{top:'-4px',right:'-4px'},{bottom:'-4px',left:'-4px'},{bottom:'-4px',right:'-4px'}];
  let i=0;
  Object.keys(UPGRADES_DEF).forEach(key=>{
    if(levels[key]>0){
      const dot=document.createElement('div');
      dot.className='facet-dot';
      Object.assign(dot.style,positions[i%positions.length]);
      dot.style.background=UPGRADES_DEF[key].color;
      dot.style.color=UPGRADES_DEF[key].color;
      facetsEl.appendChild(dot);
      i++;
    }
  });

  // Upgrade summary list
  const upgList=document.getElementById('profile-upgrades');
  upgList.innerHTML='';
  Object.keys(UPGRADES_DEF).forEach(key=>{
    const def=UPGRADES_DEF[key];
    const lvl=levels[key];
    let pips='';
    for(let p=0;p<def.max;p++)pips+=`<div class="shop-pip${p<lvl?' filled':''}" style="color:${def.color}"></div>`;
    const row=document.createElement('div');
    row.className='profile-upg-row';
    row.innerHTML=`<span>${def.name}</span><div class="profile-upg-pips">${pips}</div>`;
    upgList.appendChild(row);
  });
}
function openShop(){
  renderShop();
  showScreen('shop-screen');
}
function closeShop(){
  showScreen('start-screen');
}
function renderShop(){
  document.getElementById('shop-gold-val').textContent=getMetaGold();
  const list=document.getElementById('shop-list');
  list.innerHTML='';
  const levels=getUpgradeLevels();
  const gold=getMetaGold();
  Object.keys(UPGRADES_DEF).forEach(key=>{
    const def=UPGRADES_DEF[key];
    const lvl=levels[key];
    const maxed=lvl>=def.max;
    const cost=maxed?null:upgradeCost(key,lvl);
    const card=document.createElement('div');
    card.className='shop-card';
    let pips='';
    for(let i=0;i<def.max;i++){
      pips+=`<div class="shop-pip${i<lvl?' filled':''}" style="color:${def.color}"></div>`;
    }
    card.innerHTML=`
      <div class="shop-card-top">
        <div>
          <div class="shop-name" style="color:${def.color}">${def.name}</div>
          <div class="shop-desc">${def.desc}</div>
        </div>
      </div>
      <div class="shop-levels">${pips}</div>
      <button class="shop-buy${maxed?' maxed':''}${(!maxed&&gold<cost)?' cant-afford':''}">${maxed?'MAX LEVEL':'UPGRADE — '+cost+' GOLD'}</button>
    `;
    if(!maxed){
      card.querySelector('.shop-buy').onclick=()=>buyUpgrade(key);
    }
    list.appendChild(card);
  });
}

// ── AVATAR EVOLUTION ──────────────────────────────────────────────────────────
function updateAvatar(){
  const lvl=S.player.level;
  const tier=lvl>=9?5:lvl>=7?4:lvl>=5?3:lvl>=3?2:1;
  const gem=document.getElementById('avatar-gem');
  gem.className='avatar-gem tier'+tier;

  const facetsEl=document.getElementById('avatar-facets');
  facetsEl.innerHTML='';
  const levels=getUpgradeLevels();
  const positions=[{top:'-4px',left:'-4px'},{top:'-4px',right:'-4px'},{bottom:'-4px',left:'-4px'},{bottom:'-4px',right:'-4px'}];
  let i=0;
  Object.keys(UPGRADES_DEF).forEach(key=>{
    if(levels[key]>0){
      const dot=document.createElement('div');
      dot.className='facet-dot';
      const pos=positions[i%positions.length];
      Object.assign(dot.style,pos);
      dot.style.background=UPGRADES_DEF[key].color;
      dot.style.color=UPGRADES_DEF[key].color;
      facetsEl.appendChild(dot);
      i++;
    }
  });
}

// ── UTIL ─────────────────────────────────────────────────────────────────────
function delay(ms){return new Promise(function(r){setTimeout(r,ms);});}

window.addEventListener('resize',function(){
  resizeCanvas();
  if(document.getElementById('tutorial-overlay').classList.contains('active'))renderTutStep();
});
setTimeout(resizeCanvas,80);
(function initMuteIcon(){
  const btn=document.getElementById('mute-btn');
  const nowMuted=AudioEngine.isMuted();
  btn.textContent=nowMuted?'✕':'♪';
  btn.classList.toggle('muted',nowMuted);
})();
</script>
</body>
</html>
